<Window x:Class="ShoeStore.View.Authorization"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore.View"
        mc:Ignorable="d"
        Title="Авторизация" Height="800" Width="1200" Icon="/View/Icon.JPG" WindowStartupLocation="CenterScreen">
    <Grid Background="#FFFFFF">
        <Image Source="/View/Icon.JPG" HorizontalAlignment="Left" VerticalAlignment="Center" Height="300" Width="300" Margin="40 0 0 0"/>
        <StackPanel Height="250" Width="400" Orientation="Vertical" Background="#7FFF00" HorizontalAlignment="Right" Margin="0 0 180 0">
            <TextBlock Text="Авторизация" Margin="20" HorizontalAlignment="Center" 
                       FontSize="30" FontFamily="Times NEw Roman"/>

            <StackPanel Orientation="Horizontal" Margin="0 10">
                <TextBlock Text="Логин" Margin="10 0" Width="80"
                       FontSize="20" FontFamily="Times NEw Roman"/>

                <TextBox Name="LoginTB" FontSize="20" FontFamily="Times New Roman" Width="290"/>

            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 10">
                <TextBlock Text="Пароль" Margin="10 0" Width="80"
                       FontSize="20" FontFamily="Times NEw Roman"/>

                <PasswordBox Name="PasswordTB" FontSize="20" FontFamily="Times New Roman" Width="290"/>

            </StackPanel>
            <StackPanel Orientation="Horizontal" Height="83" Width="350" >
                <Button Content="Войти" Height="40" Width="100" Background="#00FA9A"
                    FontFamily="Times New Roman" FontSize="20" HorizontalAlignment="Center" 
                    VerticalAlignment="Bottom" Margin="10 20" Click="AuthorizationCommand"/>
                <Button Content="Войти как гость" Height="40" Width="210" Background="#00FA9A"
                    FontFamily="Times New Roman" FontSize="20" 
                    VerticalAlignment="Bottom" Click="AuthorizationGuestCommand" Margin="10 20"/>
            </StackPanel>

        </StackPanel>
    </Grid>
</Window>
