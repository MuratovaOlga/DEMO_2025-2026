<Window x:Class="ShoeStore.View.ListOfProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore.View"
        mc:Ignorable="d"
        Title="Список товаров" Height="800" Width="1200" Icon="/View/Icon.JPG" WindowStartupLocation="CenterScreen">
    <StackPanel Orientation="Vertical">
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Выход" Width="80" Margin="5,5,5,5" FontSize ="20"
                    Background="MediumSpringGreen" Height="33"/>
            <TextBlock Name="NameUser" HorizontalAlignment="Right" Margin="5,5,5,5" FontSize ="24" 
           FontFamily="Times New Roman"/>
        </StackPanel>
        
        
        <!--SP для элементов сортировки/поиска/фильтрации-->
        <StackPanel Orientation="Horizontal" Height="60" Width="1200"  HorizontalAlignment="Center" Background="#7FFF00">
            <!--Поиск-->
            <TextBox Name="SearchText" FontFamily="Times New Roman" FontSize="18" Width="300" 
                     Height="25" VerticalAlignment="Center" Margin="100,0,50,0" TextChanged="searchCommand"/>
            <!--Фильтрация-->
            <ComboBox ItemsSource="{Binding Filtration}" SelectedItem="{Binding SelectedFiltration}" 
                      Height="25" VerticalAlignment="Center" Width="170" HorizontalAlignment="Right" Margin="50 0" SelectionChanged="selectedFiltrationCommand"/>
            <!--Сортировка-->
            <ComboBox ItemsSource="{Binding Sorting}" SelectedItem="{Binding SelectedSorting}" 
                      Height="25" VerticalAlignment="Center" Width="170" 
                      HorizontalAlignment="Right" Margin="50 0" 
                      SelectionChanged="sortingCommand"/>
            <!--Кнопка для сброса-->
            <Button Content="Сброс" Width="70" Margin="50 0" Height="33" FontSize ="20" Click="ResetCommand" Background="MediumSpringGreen"/>
        </StackPanel>


        <!--LB для отображения UserControl продуктов-->
        <ListBox Name="listBoxProducts" Margin="10" Width="1040" MaxHeight="600" 
                 ScrollViewer.VerticalScrollBarVisibility="Visible" SelectionChanged="UpdateDataProduct" >
            
        </ListBox>
        <StackPanel Orientation="Horizontal">
            <Button Content="Заказы" Width="80" 
                Margin="5,0,5,10" HorizontalAlignment="Left" 
                Height="33" FontSize ="20" Background="MediumSpringGreen"/>
            <Button Content="Добавить товар" 
                Margin="5,0,5,10" HorizontalAlignment="Left" 
                Height="33" FontSize ="20" Background="MediumSpringGreen" Width="155"/>
        </StackPanel>
    </StackPanel>
</Window>
