<Window x:Class="ShoeStore.View.ListOfProducts"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore.View"
        mc:Ignorable="d"
        Title="Список товаров" Height="800" Width="1200" Icon="/View/Icon.JPG" WindowStartupLocation="CenterScreen">
    <StackPanel Orientation="Vertical">
        <TextBlock Name="NameUser" HorizontalAlignment="Right" Margin="5" FontSize ="18" 
                   FontFamily="Times New Roman" Background="MediumSpringGreen"/>
        
        
        
        <!--SP для элементов сортировки/поиска/фильтрации-->
        <StackPanel Orientation="Horizontal" Height="55" Width="1000" HorizontalAlignment="Center" Background="#7FFF00">
            <TextBox Name="SearchText" FontFamily="Times New Roman" FontSize="18" Width="300" 
                     Height="25" VerticalAlignment="Center" Margin="50 0 0 0" TextChanged="ApplyFilter"/>
            <ComboBox ItemsSource="{Binding Filtration}" SelectedItem="{Binding SelectedFiltration}" 
                      Height="25" VerticalAlignment="Center" Width="170" HorizontalAlignment="Right" Margin="50 0" SelectionChanged="SelectedFiltrationCommand"/>
            <GroupBox Header="Сортировка по количеству на складе" Margin="0 0 50 0">
                <StackPanel>
                    <RadioButton Name="Ascending" Content="По возрастанию" Checked="ascendingCommand" />
                    <RadioButton Name="Descending" Content="По убыванию" Checked="ascendingCommand"/>
                </StackPanel>
            </GroupBox>
            <Button Content="Сброс" Width="70" Height="25" Click="ResetCommand" Background="MediumSpringGreen"/>
        </StackPanel>


        <!--LB для отображения UserControl продуктов-->
        <ListBox Name="listBoxProducts" Margin="10" Width="1040" MaxHeight="710" 
                 ScrollViewer.VerticalScrollBarVisibility="Visible">
        </ListBox>
        
    </StackPanel>
</Window>
