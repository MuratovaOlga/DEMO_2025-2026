<Window x:Class="ShoeStore.Views.AddChangedProduct"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeStore.Views"
        mc:Ignorable="d" Height="513" Width="430" 
        Icon="C:/Users/Home/Desktop/VKI NSU/проекты/ShoeStore/ShoeStore/Images/Icon.JPG"
        WindowStartupLocation="CenterScreen">
    <Grid>
        <StackPanel Orientation="Vertical" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Артикул" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <TextBox Name="ArticleProductTB" Width="220" FontFamily="Times New Roman" FontSize="16"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5"> 
                <TextBlock Text="Название" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <TextBox Name="NameProductTB" Width="220" FontFamily="Times New Roman" FontSize="16"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Единица измерения" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <TextBox Name="UnitOfMeasurementProductTB" Width="220" FontFamily="Times New Roman" FontSize="16"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Цена" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <TextBox Name="PriceProductTB" Width="220" FontFamily="Times New Roman" FontSize="16"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Скидка" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <TextBox Name="CurrentDiscountProductTB" Width="220" FontFamily="Times New Roman" FontSize="16"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Количество на складе" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <TextBox Name="QuantityInStockProductTB" Width="220" FontFamily="Times New Roman" FontSize="16"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Описание" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <TextBox Name="DescriptionProductTB" TextWrapping="Wrap" AcceptsReturn="True" MaxWidth="220" Width="220" MaxHeight="80" FontFamily="Times New Roman" FontSize="16"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Производитель" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <ComboBox Name="ManufacturerCB" Width="220"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Категория" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <ComboBox Name="CategoryCB" Width="220"/>
            </StackPanel>
            
            <StackPanel Orientation="Horizontal" Margin="0 5">
                <TextBlock Text="Поставщик" Width="150" FontFamily="Times New Roman" FontSize="16"/>
                <ComboBox Name="SupplierCB" Width="220"/>
            </StackPanel>

            <Button Content="Сохранить" FontFamily="Times New Roman" FontSize="16" 
                    Width="120" HorizontalAlignment="Center" Margin="0 10" Background="#00FA9A" Click="SaveProduct"/>
        </StackPanel>
    </Grid>
</Window>
