<UserControl x:Class="ShoeStore.Views.ProductCard1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ShoeStore.Views"
             mc:Ignorable="d" d:DesignWidth="1240" Height="256">
    <Border BorderBrush="Black" BorderThickness="2" Name ="Back" >
        <Grid Width="1240">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.5*"/>
                <ColumnDefinition Width="3*"/>
                <ColumnDefinition  Width="0.7*"/>
            </Grid.ColumnDefinitions>

            <Border BorderBrush="Black" BorderThickness="2" Grid.Column="0" Margin="5" Background="White">
                <Image Source="{Binding PhotoProduct}" Height="200" Width="200" 
              Margin="5" />
            </Border>



            <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Margin="5" Background="White">
                <StackPanel Orientation="Vertical"  >
                    <TextBlock FontFamily="Times New Roman" FontSize="16" FontWeight="Bold" Margin="5" >
                     <Run Text="{Binding IdProductCategoryNavigation.CategoryName}"/>
                     <Run Text=" | "/>
                     <Run Text="{Binding NameProduct}"/>
                    </TextBlock>

                    <TextBlock FontFamily="Times New Roman" FontSize="16" TextWrapping="Wrap" MaxWidth="700" Margin="5">
                     <Run Text="Описание товара: "/>
                     <Run Text="{Binding DescriptionProduct}"/>
                    </TextBlock>

                    <TextBlock FontFamily="Times New Roman" FontSize="16" Margin="5">
                     <Run Text="Производитель: "/>
                     <Run Text="{Binding IdManufacturerNavigation.Name}"/>
                    </TextBlock>

                    <TextBlock FontFamily="Times New Roman" FontSize="16" Margin="5">
                     <Run Text="Поставщик: "/>
                     <Run Text="{Binding IdSupplierNavigation.NameSupplier}"/>
                    </TextBlock>


                    <TextBlock FontFamily="Times New Roman" FontSize="16" Margin="5">
                     <Run Text="Цена: "/>
                     <Run Text="{Binding PriceProduct, StringFormat = N2}" Name="Price"/>
                     <Run Name="DiscountPrice"/>
                    </TextBlock>

                    <TextBlock FontFamily="Times New Roman" FontSize="16" Margin="5">
                     <Run Text="Еденица измерения: "/>
                     <Run Text="{Binding UnitOfMeasurementProduct}"/>
                    </TextBlock>

                    <TextBlock FontFamily="Times New Roman" FontSize="16" Margin="5" Name="QuantityInStock">
                     <Run Text="Количество на складе: "/>
                     <Run Text="{Binding QuantityInStockProduct}"/>
                    </TextBlock>
                </StackPanel>
            </Border>



            <Border BorderBrush="Black" BorderThickness="2" Grid.Column="2" Margin="5" Background="White">
                <Grid >
                    <TextBlock  FontFamily="Times New Roman" FontSize="16" Margin="7"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Height="40" TextWrapping="Wrap" MaxWidth="200">
                     <Run Text="Действующая скидка: "/>
                     <Run Text="{Binding CurrentDiscountProduct}"/>
                    </TextBlock>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
